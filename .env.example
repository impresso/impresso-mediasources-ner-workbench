# Optional. Defaults to https://impresso-project.ch/public-api/v1.
IMPRESSO_API_URL=

# Keep false for interactive token entry without writing ~/.impresso_py.yml.
# Set true only if you intentionally want the impresso client to reuse/store
# its persisted token outside this repository.
IMPRESSO_PERSISTED_TOKEN=false

# Optional. Used by Hugging Face downloads/uploads when set.
HF_TOKEN=
