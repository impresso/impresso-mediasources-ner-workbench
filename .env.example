# Optional. Defaults to https://impresso-project.ch/public-api/v1.
IMPRESSO_API_URL=

# Optional. If set, the workbench uses this token directly and does not prompt
# through impresso-py or write ~/.impresso_py.yml.
IMPRESSO_API_TOKEN=

# Keep true to let impresso-py reuse/store its token in ~/.impresso_py.yml.
# Set false for interactive token entry without writing the cache file.
IMPRESSO_PERSISTED_TOKEN=true

# Optional. Used by Hugging Face downloads/uploads when set.
HF_TOKEN=
